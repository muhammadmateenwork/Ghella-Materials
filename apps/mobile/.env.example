EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — the web app's URL. Used for (1) "forgot password" reset
# links, so they land on the web app's /reset-password page, and (2) the
# "sign in" link in new-account welcome emails sent from the mobile app.
# If unset, reset links fall back to the project's configured Site URL,
# and welcome emails just omit the sign-in link.
EXPO_PUBLIC_WEB_URL=https://your-web-app-domain.com
